                <mxCell id="JLnVItwCgczSZeQIzUJD-42" edge="1" parent="1" source="JLnVItwCgczSZeQIzUJD-41" style="endArrow=classic;startArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;fontSize=15;" target="JLnVItwCgczSZeQIzUJD-21" value="">
                    <mxGeometry height="50" relative="1" width="50" as="geometry">
                        <mxPoint x="570" y="460" as="sourcePoint"/>
