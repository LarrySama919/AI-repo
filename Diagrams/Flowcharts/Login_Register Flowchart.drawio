                <mxCell id="yJBGhn61Mgkr4vcU5G-z-144" parent="tKPyCcq3Wq4KuG5onMI2-10" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;flipV=1;legacyAnchorPoints=0;flipH=1;fontStyle=1;fontSize=30;" value="&lt;u&gt;Login/Register Flowchart&lt;/u&gt;" vertex="1">
                    <mxGeometry height="30" width="495" x="269.5" as="geometry"/>
                </mxCell>
                <mxCell id="mUsX2Zz0RF9kwDZ_gtH3-1" parent="tKPyCcq3Wq4KuG5onMI2-10" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=20;fontStyle=1" value="&lt;span class=&quot;&quot;&gt;The flowchart outlines the user authentication flow upon entering the website, checking whether the user needs to register a new account or log into an existing one&lt;/span&gt;&lt;span class=&quot;&quot;&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span&gt;For new accounts, users submit their details for validation, complete email OTP verification, and save their data before redirecting to the login step&lt;/span&gt;&lt;span class=&quot;&quot;&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span&gt;Existing accounts undergo credentials validation, OTP verification, and password recovery support via email verification if needed&lt;/span&gt;&lt;span class=&quot;&quot;&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span class=&quot;&quot;&gt;Once verified during login, the system evaluates the account role to route the user to either the &lt;b&gt;User Dashboard&lt;/b&gt;, &lt;b&gt;Moderator Dashboard&lt;/b&gt;, or &lt;b&gt;Admin Dashboard&lt;/b&gt;&lt;/span&gt;&lt;span class=&quot;&quot;&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="175" width="1090" y="985" as="geometry"/>
                </mxCell>
