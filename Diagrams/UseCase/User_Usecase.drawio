                <mxCell id="_qDIwXR0BeGVKqvG6G54-32" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;" value="AI Model" vertex="1">
