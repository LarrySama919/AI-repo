
Project SkinHealthAssistant {
  database_type: 'MySQL'
  Note: 'AI Skin Health Assistant Database'
}

// ==========================================
// ENUMS
// ==========================================

Enum user_role {
  user
  moderator
  admin
}

Enum account_status {
  active
  suspended
}

Enum otp_purpose {
  registration
  reset_password
  login
}

Enum analysis_type {
  facial
  lesion
}

Enum analysis_status {
  pending
  completed
  failed
}

Enum image_type {
  original
  annotated
}

Enum concern_type {
  facial
  lesion
}

Enum review_status {
  pending
  approved
  rejected
  hidden
}

Enum report_status {
  pending
  resolved
  dismissed
}

Enum moderation_action {
  approve
  reject
  hide
  restore
  dismiss_report
}

Enum sentiment_type {
  positive
  neutral
  negative
}

// ==========================================
// 1. USERS
// ==========================================

Table users {
  user_id bigint [pk, increment]
  full_name varchar(100) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role user_role [not null, default: 'user']
  email_verified boolean [not null, default: false]
  account_status account_status [not null, default: 'active']
  created_at datetime [not null]
  updated_at datetime [not null]

  Note: 'User, Admin and Moderator accounts'
}

// ==========================================
// 2. OTPS
// ==========================================

Table otps {
  otp_id bigint [pk, increment]
  user_id bigint [ref: > users.user_id]
  email varchar(255) [not null]
  otp_hash varchar(255) [not null]
  action_type otp_purpose [not null]
  is_used boolean [not null, default: false]
  resend_count int [not null, default: 0]
  attempt_count int [not null, default: 0]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  expires_at timestamp [not null]

  Note: 'Email verification and password reset'
}

// ==========================================
// 3. SKIN ANALYSES
// ==========================================

Table skin_analyses {
  analysis_id bigint [pk, increment]
  user_id bigint [not null, ref: > users.user_id]
  analysis_type analysis_type [not null]
  status analysis_status [not null, default: 'pending']
  guidance_text text
  created_at datetime [not null]
  completed_at datetime

  Note: 'Facial analysis and lesion screening sessions'
}

// ==========================================
// 4. SKIN IMAGES
// ==========================================

Table skin_images {
  image_id bigint [pk, increment]
  analysis_id bigint [not null, ref: > skin_analyses.analysis_id]
  image_path varchar(500) [not null]
  image_type image_type [not null]
  quality_passed boolean
  quality_reason varchar(255)
  uploaded_at datetime [not null]

  Note: 'Original and AI annotated images'
}

// ==========================================
// 5. SKIN CONCERNS
// ==========================================

Table skin_concerns {
  concern_id int [pk, increment]
  code varchar(30) [not null, unique]
  concern_name varchar(100) [not null]
  concern_type concern_type [not null]
  description text

  Note: 'Facial concerns and HAM10000 lesion classes'
}

// ==========================================
// 6. ANALYSIS RESULTS
// ==========================================

Table analysis_results {
  result_id bigint [pk, increment]
  analysis_id bigint [not null, ref: > skin_analyses.analysis_id]
  concern_id int [not null, ref: > skin_concerns.concern_id]
  confidence decimal(5,4)
  severity_score decimal(5,4)
  uncertainty_score decimal(5,4)
  is_uncertain boolean [not null, default: false]
  highlight_data json
  model_version varchar(50)
  created_at datetime [not null]

  Note: 'AI predictions, confidence and visual highlights'
}

// ==========================================
// 7. SYMPTOM QUESTIONS
// ==========================================

Table symptom_questions {
  question_id bigint [pk, increment]
  question_code varchar(50) [not null, unique]
  question_text text [not null]
  question_type varchar(30) [not null]
  analysis_type analysis_type [not null]
  is_active boolean [not null, default: true]
  created_at datetime [not null]

  Note: 'Predefined symptom questionnaire'
}

// ==========================================
// 8. SYMPTOM RESPONSES
// ==========================================

Table symptom_responses {
  response_id bigint [pk, increment]
  analysis_id bigint [not null, ref: > skin_analyses.analysis_id]
  question_id bigint [not null, ref: > symptom_questions.question_id]
  answer_text text
  answered_at datetime

  indexes {
    (analysis_id, question_id) [unique]
  }

  Note: 'User answers for each analysis'
}

// ==========================================
// 9. PRODUCTS
// ==========================================

Table products {
  product_id bigint [pk, increment]
  product_name varchar(200) [not null]
  brand varchar(100)
  category varchar(100)
  ingredients text
  description text
  price decimal(10,2)
  image_path varchar(500)
  is_active boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime

  Note: 'Skincare product catalog'
}

// ==========================================
// 10. RECOMMENDATION REQUESTS
// ==========================================

Table recommendation_requests {
  request_id bigint [pk, increment]
  user_id bigint [not null, ref: > users.user_id]
  analysis_id bigint [ref: > skin_analyses.analysis_id]
  budget_min decimal(10,2)
  budget_max decimal(10,2)
  skin_type varchar(50)
  preferences text
  created_at datetime [not null]

  Note: 'User budget and product preferences'
}

// ==========================================
// 11. REQUEST CONCERNS
// ==========================================

Table request_concerns {
  request_concern_id bigint [pk, increment]
  request_id bigint [not null, ref: > recommendation_requests.request_id]
  concern_id int [not null, ref: > skin_concerns.concern_id]

  indexes {
    (request_id, concern_id) [unique]
  }

  Note: 'Selected skin concerns for product matching'
}

// ==========================================
// 12. PRODUCT RECOMMENDATIONS
// ==========================================

Table product_recommendations {
  recommendation_id bigint [pk, increment]
  request_id bigint [not null, ref: > recommendation_requests.request_id]
  product_id bigint [not null, ref: > products.product_id]
  match_score decimal(5,4)
  reason text
  created_at datetime [not null]

  indexes {
    (request_id, product_id) [unique]
  }

  Note: 'Recommended products and matching scores'
}

// ==========================================
// 13. PROGRESS COMPARISONS
// ==========================================

Table progress_comparisons {
  comparison_id bigint [pk, increment]
  user_id bigint [not null, ref: > users.user_id]
  before_analysis_id bigint [not null, ref: > skin_analyses.analysis_id]
  after_analysis_id bigint [not null, ref: > skin_analyses.analysis_id]
  comparison_summary text
  created_at datetime [not null]

  indexes {
    (user_id, before_analysis_id, after_analysis_id) [unique]
  }

  Note: 'Before and after facial skin comparisons'
}

// ==========================================
// 14. PRODUCT REVIEWS
// ==========================================

Table product_reviews {
  review_id bigint [pk, increment]
  user_id bigint [not null, ref: > users.user_id]
  product_id bigint [not null, ref: > products.product_id]
  rating tinyint [not null, note: 'Rating 1 to 5']
  review_text text
  status review_status [not null, default: 'pending']
  created_at datetime [not null]
  updated_at datetime [not null]

  Note: 'User product ratings and reviews'
}

// ==========================================
// 15. REVIEW REPORTS
// ==========================================

Table review_reports {
  report_id bigint [pk, increment]
  review_id bigint [not null, ref: > product_reviews.review_id]
  reporter_id bigint [not null, ref: > users.user_id]
  reason varchar(100) [not null]
  details text
  status report_status [not null, default: 'pending']
  created_at datetime [not null]

  indexes {
    (review_id, reporter_id) [unique]
  }

  Note: 'Reviews reported by users'
}

// ==========================================
// 16. REVIEW MODERATIONS
// ==========================================

Table review_moderations {
  moderation_id bigint [pk, increment]
  review_id bigint [not null, ref: > product_reviews.review_id]
  report_id bigint [ref: > review_reports.report_id]
  moderator_id bigint [not null, ref: > users.user_id]
  action moderation_action [not null]
  reason text
  created_at datetime [not null]

  Note: 'Moderator decisions and action history'
}

// ==========================================
// 17. REVIEW AI CHECKS
// ==========================================

Table review_ai_checks {
  check_id bigint [pk, increment]
  review_id bigint [not null, ref: > product_reviews.review_id]
  model_version varchar(50)
  flag_score decimal(5,4)
  is_flagged boolean [not null, default: false]
  flag_reason text
  checked_at datetime [not null]

  Note: 'Automated review screening'
}

// ==========================================
// 18. REVIEW SENTIMENTS
// ==========================================

Table review_sentiments {
  sentiment_id bigint [pk, increment]
  review_id bigint [not null, ref: > product_reviews.review_id]
  sentiment sentiment_type [not null]
  confidence decimal(5,4)
  extracted_complaints json
  model_version varchar(50)
  analyzed_at datetime [not null]

  Note: 'Review sentiment and complaint extraction'
}

// ==========================================
// 19. ADMIN AUDIT LOGS
// ==========================================

Table admin_audit_logs {
  log_id bigint [pk, increment]
  admin_id bigint [not null, ref: > users.user_id]
  action varchar(100) [not null]
  target_type varchar(50)
  target_id bigint [note: 'Generic target ID; no FK']
  details json
  created_at datetime [not null]

  Note: 'Admin management activity history'
}
